# Copy this file to .env and fill in your own values. NEVER commit .env
PORT=5000
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/gym?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# Only for the one-time /api/setup-admin route on Vercel (delete after use)
SETUP_KEY=

# Used only by seed.js to create the first admin account
ADMIN_NAME=Your Name
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose_a_strong_password
